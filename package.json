{
  "name": "eslint-plugin-sitecore-jss",
  "version": "1.1.6",
  "description": "ESLint plugin that enforces correct usage of Sitecore JSS / Content SDK field components (Text, RichText, Image, Link, File)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "docs/rules/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "sitecore",
    "sitecore-jss",
    "content-sdk",
    "xm-cloud",
    "nextjs",
    "typescript"
  ],
  "author": "Sohrab Saboori",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rikaweb/eslint-plugin-sitecore-jss.git"
  },
  "homepage": "https://github.com/rikaweb/eslint-plugin-sitecore-jss#readme",
  "bugs": {
    "url": "https://github.com/rikaweb/eslint-plugin-sitecore-jss/issues"
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^7.0.0 || ^8.0.0",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "eslint": "^10.12.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
