{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "vitest.config.mts"],
  "exclude": ["tests/fixtures/**", "node_modules", "dist"]
}
